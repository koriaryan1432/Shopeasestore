# Copy this file to .env and adjust values before running docker compose up

# MySQL
DB_NAME=ecommerce_db
DB_PASSWORD=rootpassword

# Backend auth
JWT_SECRET=change_this_to_a_long_random_string

# Email Configuration (Nodemailer/SMTP)
# For Gmail, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and SMTP_PASS should be your Google App Password.
SMTP_HOST=your-smtp-host.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="ShopEase <your-email@example.com>"

# Twilio SMS Configuration (Phone OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_PHONE_NUMBER=your_twilio_phone_number_placeholder

# Google OAuth Integration
GOOGLE_CLIENT_ID=your_google_client_id_placeholder

# Gemini API Key (Optional: for live customer chat bot AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Public URL of the website
FRONTEND_URL=http://localhost

